# Whitelist: Nur ausdrücklich erlaubte Dateien kommen ins Repository.
# Alles andere (privat/, daten/, bots/, Sicherungen *.bak*, Logs) bleibt lokal.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/AGENTS.en.md
!/README.en.md
!/LICENSE
!/server.py
!/start.sh
!/config.example.json
!/web/
!/raeume/
!/plugins/
!/scripts/
!/docs/
*.bak*
*.log
__pycache__/
.DS_Store
